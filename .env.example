# Symphony by Interlude — Environment Variables
# Copy this file to .env.local and fill in real values

# === Supabase (REQUIRED) ===
# Get from: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# === App URL (REQUIRED in production) ===
# Local: http://localhost:3000
# Production: your custom domain (e.g., https://symphony.interlude.studio)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Notion Integration (OPTIONAL — but recommended) ===
# Creates a Notion task for each request, syncs status changes back
# Setup:
#   1. Go to https://www.notion.so/profile/integrations
#   2. Create a new internal integration
#   3. Copy the API key (Internal Integration Token)
#   4. Share your Tasks database AND any Project pages with this integration
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Slack Notifications (OPTIONAL) ===
# Posts a message to a Slack channel when new requests are submitted
# Setup:
#   1. Go to https://api.slack.com/apps
#   2. Create a new app, add an Incoming Webhook
#   3. Choose the channel and copy the webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
